{
  "expo": {
    "name": "Polaris",
    "slug": "polaris",
    "scheme": "polaris",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.lux.polaris.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "HWD6374DUX",
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.lux.polaris"]
      }
    },
    "plugins": ["expo-secure-store", "@bacons/apple-targets"]
  }
}
