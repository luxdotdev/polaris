{
  "expo": {
    "name": "Polaris",
    "slug": "polaris",
    "scheme": "polaris",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.lux.polaris.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Polaris listens while you dictate a prompt; your host turns it into text.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Polaris attaches the photos you choose to an agent session.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
