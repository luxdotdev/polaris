{
  "expo": {
    "name": "Polaris",
    "slug": "polaris",
    "scheme": "polaris",
    "version": "0.4.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "dev.lux.polaris.mobile",
      "buildNumber": "6",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "HWD6374DUX",
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.lux.polaris"],
        "keychain-access-groups": ["$(AppIdentifierPrefix)dev.lux.polaris.shared"]
      }
    },
    "plugins": [
      "expo-secure-store",
      "@bacons/apple-targets",
      [
        "expo-camera",
        {
          "cameraPermission": "Polaris uses the camera to scan the link code the Desktop App shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Polaris listens while you dictate a prompt; your host turns it into text.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Polaris attaches the photos you choose to an agent session.",
          "cameraPermission": "Polaris uses the camera to scan the link code the Desktop App shows.",
          "microphonePermission": "Polaris listens while you dictate a prompt; your host turns it into text."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ]
    ]
  }
}
