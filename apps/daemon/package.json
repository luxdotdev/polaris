{
  "name": "@polaris/daemon",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "polaris": "./src/main.ts"
  },
  "scripts": {
    "build": "bun ../../scripts/build-daemon.ts",
    "dev": "bun --watch src/main.ts serve --foreground",
    "typecheck": "tsc -p .",
    "test": "bun test --pass-with-no-tests",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@effect/platform-bun": "4.0.0-rc.118",
    "@effect/sql-sqlite-bun": "4.0.0-rc.118",
    "@ff-labs/fff-bun": "0.11.1-nightly.89c1927",
    "@polaris/protocol": "workspace:*",
    "effect": "4.0.0-rc.118"
  },
  "devDependencies": {
    "@polaris/client": "workspace:*"
  }
}
