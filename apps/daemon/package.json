{
  "name": "@polaris/daemon",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "polaris": "./src/main.ts"
  },
  "scripts": {
    "build": "bun ../../scripts/build-daemon.ts",
    "dev": "bun --watch src/main.ts serve --foreground",
    "typecheck": "tsc -p . && tsc -p scripts",
    "test": "bun test --pass-with-no-tests",
    "smoke": "bun scripts/smoke.ts",
    "smoke:review": "bun scripts/reviewCheckoutSmoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@ast-grep/lang-bash": "0.0.8",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.45.3",
    "@effect/platform-bun": "4.0.0-rc.118",
    "@effect/sql-sqlite-bun": "4.0.0-rc.118",
    "@ff-labs/fff-bun": "0.11.1-nightly.89c1927",
    "@polaris/protocol": "workspace:*",
    "effect": "4.0.0-rc.118",
    "xstate": "6.0.0-alpha.61",
    "@polaris/client": "workspace:*"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "fast-check": "4.10.2"
  },
  "optionalDependencies": {
    "@ast-grep/napi-darwin-arm64": "0.45.3",
    "@ast-grep/napi-linux-arm64-gnu": "0.45.3",
    "@ast-grep/napi-linux-arm64-musl": "0.45.3",
    "@ast-grep/napi-linux-x64-gnu": "0.45.3",
    "@ast-grep/napi-linux-x64-musl": "0.45.3"
  }
}
