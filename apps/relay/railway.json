{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/relay/Dockerfile",
    "watchPatterns": ["apps/relay/**", "packages/protocol/**", "bun.lock"]
  },
  "deploy": {
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "drainingSeconds": 10
  }
}
