{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@polaris/daemon#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-daemon.ts"],
      "outputs": ["dist/**"]
    },
    "@polaris/site#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "AWS_REGION",
        "AWS_ROLE_ARN",
        "POLARIS_EMAIL_FROM",
        "POLARIS_EMAIL_CONFIGURATION_SET"
      ]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "env": ["POLARIS_PBT_*"] },
    "dev": { "cache": false, "persistent": true },
    "bench": {
      "cache": false,
      "passThroughEnv": ["POLARIS_*", "BUN_*", "GITHUB_STEP_SUMMARY", "TMPDIR"]
    }
  }
}
