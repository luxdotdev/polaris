{
  "name": "polaris",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "turbo run bench --log-prefix=none --",
    "lint": "biome check . && bun tooling/lint/ratchet.ts",
    "lint:baseline": "bun tooling/lint/ratchet.ts --update-baseline",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "licenses": "bun scripts/licenses.ts",
    "licenses:check": "bun scripts/licenses.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  }
}
