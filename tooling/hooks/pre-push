#!/bin/sh
# Backstop for commits that skipped pre-commit: re-checks the files changed in the
# pushed commits without writing, then typechecks and tests the changed packages.
if [ ! -x node_modules/.bin/biome ] || [ ! -x node_modules/.bin/turbo ]; then
  echo "pre-push: dependencies aren't installed in $(pwd). Run bun install there, then push again." >&2
  exit 1
fi

exec bun tooling/quality/pre-push.ts
